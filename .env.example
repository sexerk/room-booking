POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=room_booking
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${POSTGRES_DB}

REDIS_URL=redis://redis:6379/0

RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

SECRET_KEY=change-this-to-a-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

ENVIRONMENT=development
LOG_LEVEL=INFO

MIN_BOOKING_MINUTES=15
MAX_BOOKING_DAYS=7
PENDING_EXPIRY_MINUTES=15
REMINDER_MINUTES_BEFORE=30